{
  "name": "creative-ops",
  "version": "0.1.0",
  "description": "Local-first creative production workflow plugin for Obsidian.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
		"lint": "eslint src",
    "test": "tsx --test tests/**/*.test.ts",
    "check:security": "node scripts/security-check.mjs",
    "check:release": "node scripts/release-check.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.15.17",
    "esbuild": "0.25.5",
    "eslint": "9.39.4",
    "eslint-plugin-obsidianmd": "0.4.0",
    "globals": "17.6.0",
		"obsidian": "1.8.7",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "typescript-eslint": "8.59.1"
  }
}
